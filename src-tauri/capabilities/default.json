{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for VocalPro main window with least-privilege core permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:default",
    "core:window:default",
    "core:window:allow-set-always-on-top"
  ]
}
